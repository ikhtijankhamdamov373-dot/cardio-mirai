# Copy to .env.local for local development. Never commit .env.local.

# Origin of the existing FastAPI backend (Render URL in production).
# Used server-side by next.config.js rewrites and app/api/health/route.ts.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Legacy static site URL, used by the ECG AI migration notice page until
# the ECG interface is ported into this frontend.
NEXT_PUBLIC_LEGACY_SITE_URL=https://cardiomirai.com
